# Copy to .env (gitignored) and fill in. Never commit real values.

# Decision engine (src/decision_engine)
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_API_URL=https://api.cheaperinference.com
# Primary classifies; Secondary is the fallback if the Primary call errors;
# Confirmation re-checks manual_triage and confidence < 75 results.
# Leave Secondary or Confirmation blank to skip that step; a ticket is never
# re-run on the model that already answered it.
CHEAPER_INFERENCE_PRIMARY_MODEL_NAME=
CHEAPER_INFERENCE_SECONDARY_MODEL_NAME=
CHEAPER_INFERENCE_CONFIRMATION_MODEL_NAME=
MONGO_URI=mongodb://localhost:27017

# Optional overrides
# MONGO_DB=support_db
# MONGO_COLLECTION=tickets
# DECISION_ENGINE_MODEL=claude-opus-4.8
