# Copy to .env (gitignored) and fill in. Never commit real values.

# Decision engine (src/decision_engine)
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_API_URL=https://api.cheaperinference.com
# Primary classifies; Secondary is the fallback if the Primary call errors;
# Confirmation re-checks manual_triage and confidence < 75 results.
# Leave Secondary or Confirmation blank to skip that step; a ticket is never
# re-run on the model that already answered it.
CHEAPER_INFERENCE_PRIMARY_MODEL_NAME=
CHEAPER_INFERENCE_SECONDARY_MODEL_NAME=
CHEAPER_INFERENCE_CONFIRMATION_MODEL_NAME=
# The Tag Normalizer's language-model option (src/tag_llm.py); blank uses the
# primary model above.
# TAG_NORMALIZER_MODEL=
# Full-text search (src/decision_engine/search.py) needs Atlas or the
# mongodb/mongodb-atlas-local image; a plain local mongod has no $search. e.g.
#   docker run -d -p 27017:27017 mongodb/mongodb-atlas-local
#   MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_URI=mongodb://localhost:27017

# Optional overrides
# MONGO_DB=support_db
# MONGO_COLLECTION=tickets
# DECISION_ENGINE_MODEL=claude-opus-4.8

# Topic modelling (src/topic_store.py): saved runs go to TOPIC_MODEL_DIR on
# local disk; Mongo keeps only each run's details in TOPIC_RUNS_COLLECTION.
# TOPIC_MODEL_DIR=topic_models
# TOPIC_RUNS_COLLECTION=topic_modeling_run_log
# BERTOPIC_RUNS_COLLECTION=bertopic_run_log

# Model storage (src/model_storage.py): with MODEL_BUCKET set, each trained
# run is also uploaded to S3-compatible storage. Backblaze B2: set the
# endpoint (region is read from it). AWS S3: leave the endpoint blank and set
# MODEL_STORAGE_REGION.
# MODEL_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# Required with a bucket; the same on every computer sharing models. Downloads
# are only opened if their signed manifest verifies with it (model files are
# pickles, which run code when loaded). Generate: python -m model_storage new-key
# MODEL_SIGNING_KEY=
# B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# MODEL_STORAGE_REGION=
# MODEL_PREFIX=topic-models/

# Feedback loop (src/decision_engine/feedback.py)
# MISCLASSIFICATION_COLLECTION=misclassification_log
# LESSONS_COLLECTION=lessons_learned

# Labelled evaluation (src/decision_engine/evaluation.py); with RUN_LIVE_EVAL=1
# the test suite prints a confusion matrix for this set. Paid model calls.
# EVAL_SET_PATH=eval_sets/backlog_sample.json

# Voyage AI embeddings (src/embeddings.py; Embed Tickets on the Decision
# Engine tab). Paid calls that send each ticket's subject and first requester
# comment to Voyage. Dimensions: 256, 512, 1024 or 2048.
EMBEDDING_API_KEY=
# EMBEDDING_API_URL=https://api.voyageai.com/v1/embeddings
# EMBEDDING_MODEL=voyage-3.5
# EMBEDDING_DIMENSIONS=1024

# Embedding model comparison (src/embedding_eval.py) also uses the Voyage
# settings above; OpenAI is compared only when this is set.
# OPENAI_API_KEY=

# Embedding model used by the app (editable in Settings > Embeddings).
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
