<?xml version="1.0" encoding="utf-8"?>
<!--
  Describes the Lasso installer to productbuild (see packaging/build_pkg.sh).
  @IDENTIFIER@ and @VERSION@ are filled in from Lasso.app's Info.plist at
  build time. The welcome and conclusion pages are in resources/.
-->
<installer-gui-script minSpecVersion="2">
    <title>Lasso</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- customize="never": no "Customize" button (there is one component).
         hostArchitectures="arm64": the app is built for Apple Silicon only, so
         an Intel Mac is refused here instead of failing at first launch. -->
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>

    <!-- Installs for every user of the Mac, into /Applications only. -->
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>

    <!-- SciPy's Fortran runtime inside the app needs macOS 12.3. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.3"/>
        </allowed-os-versions>
    </volume-check>

    <!-- What gets installed: one hidden choice holding the component package. -->
    <choices-outline>
        <line choice="default">
            <line choice="@IDENTIFIER@"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="@IDENTIFIER@" visible="false">
        <pkg-ref id="@IDENTIFIER@"/>
    </choice>
    <pkg-ref id="@IDENTIFIER@" version="@VERSION@" onConclusion="none">Lasso-component.pkg</pkg-ref>
</installer-gui-script>
